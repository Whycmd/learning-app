# ============================================================
# 环境变量模板
#
# 用法：复制一份并改名，然后按需修改
#     cp .env.example .env
#
# .env 文件不会提交到 git，密码和 Key 只留在你自己的电脑上。
# ============================================================

# ---------- 数据库 ----------
# 下面三个密码改成你自己的任意字符串（建议只用字母和数字，别用中文或空格）
MYSQL_ROOT_PASSWORD=elf_root_local
MYSQL_DATABASE=english_learning
MYSQL_USER=eng_app
MYSQL_PASSWORD=elf_app_local

# ---------- 应用 ----------
# 浏览器访问地址就是 http://127.0.0.1:<APP_PORT>
APP_PORT=8088
TZ=Asia/Shanghai

# ---------- AI ----------
# 智谱 BigModel 的 API Key，免费申请：https://open.bigmodel.cn
# 留空也能正常启动，只是"知识点固化 / 出题 / 批改"这三个 AI 功能会提示未配置
ZHIPU_API_KEY=

# ---------- 镜像源 ----------
# Docker Hub 官方仓库在国内经常连不上，所以默认走国内加速器。
# 如果你的网络能直连 Docker Hub，可以改成 mysql:8.0 和 node:20-slim
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
BASE_IMAGE=docker.m.daocloud.io/library/node:20-slim
