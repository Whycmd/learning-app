# ============================================================
# 生产环境变量模板（比赛评审用）
#
# 用法：
#   cp .env.prod.example .env.prod    ← 填下面的密码与 Key
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# .env.prod 含真实密码，已在 .gitignore 中排除，不要提交。
# 密码建议只用字母和数字，长度 16 位以上。
# ============================================================

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=english_learning
MYSQL_USER=eng_app
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD

# ---------- 应用 ----------
TZ=Asia/Shanghai

# ---------- AI ----------
# 智谱 BigModel 的 API Key；留空也能启动，只是 AI 功能不可用
ZHIPU_API_KEY=

# ---------- 镜像源 ----------
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
BASE_IMAGE=docker.m.daocloud.io/library/node:20-slim
